template <int BITS, typename UInt>
constexpr auto count_digits(UInt n) -> int {

  if (!is_constant_evaluated() && num_bits<UInt>() == 32)
    return (__builtin_clz(static_cast<uint32_t>(n) | 1) ^ 31) / BITS + 1;


  return [](UInt m) {
    int num_digits = 0;
    do {
      ++num_digits;
    } while ((m >>= BITS) != 0);
    return num_digits;
  }(n);
