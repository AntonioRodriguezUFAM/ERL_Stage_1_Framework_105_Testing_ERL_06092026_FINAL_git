    )
                                                                       ;
    checkCuda((cudaStreamSynchronize(res.stream)), "cudaStreamSynchronize(res.stream)", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 513);
    std::copy(res.h_pinned, res.h_pinned + dataSize, processedBuffer.begin());
