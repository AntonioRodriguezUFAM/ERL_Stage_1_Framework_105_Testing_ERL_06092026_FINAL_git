          void histogramCdfKernel(const unsigned int* hist, int* cdf, int* minCdfOut) {
    
# 146 "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu" 3
   __attribute__((shared)) 
# 146 "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu"
              int sdata[256];
    const int tid = threadIdx.x;

    sdata[tid] = static_cast<int>(hist[tid]);
    __syncthreads();


    for (int stride = 1; stride < 256; stride <<= 1) {
        int val = 0;
        if (tid >= stride) val = sdata[tid - stride];
        __syncthreads();
        sdata[tid] += val;
        __syncthreads();
    }

    cdf[tid] = sdata[tid];





    if (tid == 0) {
        int mn = 0;
        for (int i = 0; i < 256; ++i) {
            if (sdata[i] > 0) { mn = sdata[i]; break; }
        }
        *minCdfOut = mn;
    }
}


# 176 "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu" 3
__attribute__((global)) 
# 176 "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu"
          void remapKernel(const uint8_t* input, uint8_t* output,
                            int width, int height,
                            const int* cdf, int minCdf) {
    const int x = blockIdx.x * blockDim.x + threadIdx.x;
    const int y = blockIdx.y * blockDim.y + threadIdx.y;
    if (x >= width || y >= height) return;

    const int idx = (y * width + x) * 2;
    const int totalPixels = width * height;

    const int c = cdf[input[idx]];
    const int denom = totalPixels - minCdf;
    uint8_t newY = 0;
    if (denom > 0) {
        const float norm = float(c - minCdf) / float(denom);
        newY = d_sat_u8(int(norm * 255.0f));
    }

    output[idx] = newY;
    output[idx + 1] = 128;
}


