        spdlog::warn("[CUDA Sobel] Invalid frame/dataPtr");
        return;
    }

    const int width = frame->width;
    const int height = frame->height;
    const size_t dataSize = frame->size;

    initCudaResources(res, dataSize);

    checkCuda((cudaMemcpyAsync(res.d_in, frame->dataPtr, dataSize, cudaMemcpyHostToDevice, res.stream)), "cudaMemcpyAsync(res.d_in, frame->dataPtr, dataSize, cudaMemcpyHostToDevice, res.stream)",
