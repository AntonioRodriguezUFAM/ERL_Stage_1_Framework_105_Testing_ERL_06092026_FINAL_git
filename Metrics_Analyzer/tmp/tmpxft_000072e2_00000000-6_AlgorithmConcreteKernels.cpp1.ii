void launchMandelbrotKernel(
    CudaResources& res,
    const std::shared_ptr<ZeroCopyFrameData>& frame,
    std::vector<uint8_t>& processedBuffer)
{
    const int width = frame->width;
    const int height = frame->height;
    const size_t dataSize = width * height;
    const int max_iter = 100;


    dim3 block(16, 16);
    dim3 grid((width + 15) / 16, (height + 15) / 16);


    mandelbrotKernel<<<grid, block, 0, res.stream>>>(res.d_out, width, height, max_iter);
    checkCuda(cudaGetLastError(), "launchMandelbrotKernel", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 539);


    checkCuda(cudaMemcpyAsync(processedBuffer.data(), res.d_out, dataSize,
                              cudaMemcpyDeviceToHost, res.stream),
              "launchMandelbrotKernel D2H", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 544);

    checkCuda(cudaStreamSynchronize(res.stream), "launchMandelbrotKernel sync", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 546);
}



