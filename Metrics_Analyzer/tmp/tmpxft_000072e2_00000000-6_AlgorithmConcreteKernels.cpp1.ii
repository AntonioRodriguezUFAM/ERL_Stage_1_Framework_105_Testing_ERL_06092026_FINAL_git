# 238 "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu"
          void invertYUYVKernel(const unsigned char* in,
                                 unsigned char* out,
                                 int width, int height)
{
    int x2 = (blockIdx.x * blockDim.x + threadIdx.x) * 2;
    int y = blockIdx.y * blockDim.y + threadIdx.y;
    if (x2 + 1 >= width || y >= height) return;

    int idx = y * width * 2 + x2 * 2;
    out[idx] = 255 - in[idx];
    out[idx + 1] = in[idx + 1];
    out[idx + 2] = 255 - in[idx + 2];
    out[idx + 3] = in[idx + 3];
}





# 256 "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu" 3
__attribute__((global)) 
# 256 "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu"
          void mandelbrotKernel(uint8_t* d_out, int width, int height, int max_iter) {
    int x = blockIdx.x * blockDim.x + threadIdx.x;
    int y = blockIdx.y * blockDim.y + threadIdx.y;

    if (x < width && y < height) {


        float cx = (x * 3.0f / (float)width) - 2.0f;
        float cy = (y * 3.0f / (float)height) - 1.5f;

        float zx = 0.0f;
        float zy = 0.0f;
        int iter = 0;

        while (zx * zx + zy * zy <= 4.0f && iter < max_iter) {
            float tmp = zx * zx - zy * zy + cx;
            zy = 2.0f * zx * zy + cy;
            zx = tmp;
            iter++;
        }


        uint8_t pixelValue = (iter == max_iter) ? 0 : (uint8_t)((iter * 255) / max_iter);
        d_out[y * width + x] = pixelValue;
    }
}




