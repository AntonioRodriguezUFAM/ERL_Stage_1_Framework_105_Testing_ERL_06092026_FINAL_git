    if (!res.d_hist) {
        checkCuda((cudaMalloc(&res.d_hist, 256 * sizeof(unsigned int))), "cudaMalloc(&res.d_hist, 256 * sizeof(unsigned int))", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 311);
        checkCuda((cudaMalloc(&res.d_cdf, 257 * sizeof(int))), "cudaMalloc(&res.d_cdf, 257 * sizeof(int))", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 312);
        spdlog::info("[CudaResources] Allocated histogram/CDF buffers");
