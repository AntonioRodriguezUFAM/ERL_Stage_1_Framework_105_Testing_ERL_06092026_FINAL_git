        if (res.h_pinned) { checkCuda((cudaFreeHost(res.h_pinned)), "cudaFreeHost(res.h_pinned)", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 299); res.h_pinned = nullptr; }

        checkCuda((cudaMalloc(&res.d_in, dataSize)), "cudaMalloc(&res.d_in, dataSize)", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 301);
        checkCuda((cudaMalloc(&res.d_out, dataSize)), "cudaMalloc(&res.d_out, dataSize)", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 302);
        checkCuda((cudaMalloc(&res.d_tmp, dataSize)), "cudaMalloc(&res.d_tmp, dataSize)", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 303);
        checkCuda((cudaMallocHost(reinterpret_cast<void**>(&res.h_pinned), dataSize)), "cudaMallocHost(reinterpret_cast<void**>(&res.h_pinned), dataSize)", "/home/ansorosa/Desktop/CODE_REPOSITORIO/ERL_Stage_1_Framework_72_Testing_ERL_17052026/Stage_01/Concretes/AlgorithmConcreteKernels.cu", 304);
        res.capacity = dataSize;
        spdlog::info("[CudaResources] Allocated device/pinned buffers: {} bytes", dataSize);
